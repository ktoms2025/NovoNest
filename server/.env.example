# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Anthropic API key used for question generation + grading calls.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for both LLM calls.
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: port the Express API listens on. Defaults to 8787.
PORT=8787
